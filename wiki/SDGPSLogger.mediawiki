print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
print "<kml xmlns=\"http://earth.google.com/kml/2.0\">\n";
print "  <Document>\n";
print "    <Placemark>\n";
print "      <LineString>\n";
print "        <coordinates>\n";

while ($line = <STDIN>) {
  @data = split(/\t/,$line);
  $latitude = $data[1]/100000;
  $longitude = $data[0]/100000;

  print "          $latitude,$longitude,0\n";
}

print "        </coordinates>\n";
print "      </LineString>\n";
print "      <Style>\n";
print "        <LineStyle>\n";
print "          <color>#ff0000ff</color>\n";
print "          <width>5</width>\n";
print "        </LineStyle>\n";
print "      </Style>\n";
print "    </Placemark>\n";
print "  </Document>\n";
print "</kml>\n";
