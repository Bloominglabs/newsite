<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solar Panel & Battery Sizing Calculator</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 20px auto; padding: 20px; }
        h1 { text-align: center; }
        label { display: block; margin: 10px 0 5px; }
        input, button { padding: 8px; width: 100%; box-sizing: border-box; }
        button { background: #007bff; color: white; border: none; cursor: pointer; margin-top: 20px; }
        #results { margin-top: 30px; padding: 15px; background: #f8f9fa; border: 1px solid #ddd; }
        .note { font-size: 0.9em; color: #555; }
    </style>
</head>
<body>
    <h1>Solar Panel & Li-ion Battery Sizing Calculator (24/7 Operation)</h1>
    <p>Inputs current draw and latitude to recommend a solar panel and rechargeable Li-ion battery for reliable off-grid operation.</p>

    <label for="mA">Current draw (mA):</label>
    <input type="number" id="mA" value="100" min="1">

    <label for="latitude">Latitude (degrees, e.g., 45 or -33 for southern hemisphere):</label>
    <input type="number" id="latitude" value="40" step="0.1">

    <button onclick="calculate()">Calculate</button>

    <div id="results"></div>

    <p class="note">
        Assumptions: 3.7V Li-ion system • 30% safety margin • 2 days autonomy • Conservative worst-month PSH.<br>
        For precise PSH, use tools like Global Solar Atlas.
    </p>

    <script>
        function calculate() {
            const mA = parseFloat(document.getElementById('mA').value);
            const latInput = parseFloat(document.getElementById('latitude').value);
            if (isNaN(mA) || isNaN(latInput) || mA <= 0) {
                document.getElementById('results').innerHTML = '<p style="color:red;">Please enter valid positive numbers.</p>';
                return;
            }

            const absLat = Math.abs(latInput);
            let PSH;
            if (absLat < 15) PSH = 5.0;
            else if (absLat < 30) PSH = 4.5;
            else if (absLat < 40) PSH = 4.0;
            else if (absLat < 50) PSH = 3.5;
            else if (absLat < 60) PSH = 3.0;
            else PSH = 2.5;

            const V = 3.7;
            const safety = 1.3;
            const autonomy = 2;

            const powerW = (mA / 1000) * V;
            const dailyWh = powerW * 24;
            const panelW = (dailyWh / PSH) * safety;
            const batteryMah = (dailyWh / V) * 1000 * autonomy;

            const panelRounded = Math.ceil(panelW);
            const batteryRounded = Math.ceil(batteryMah / 1000) * 1000; // Next 1000 mAh

            const results = `
                <h2>Results</h2>
                <p><strong>Current draw:</strong> ${mA} mA</p>
                <p><strong>Latitude:</strong> ${latInput}° (estimated conservative PSH: ${PSH} hours/day)</p>
                <p><strong>Daily energy consumption:</strong> ${dailyWh.toFixed(2)} Wh</p>
                <p><strong>Recommended solar panel:</strong> ${panelW.toFixed(1)} W<br>
                → Choose at least a <strong>${panelRounded} W</strong> panel (or next common size, add 20-50% margin in cloudy areas)</p>
                <p><strong>Recommended Li-ion battery:</strong> ${batteryMah.toFixed(0)} mAh<br>
                → Choose at least <strong>${batteryRounded} mAh</strong> (e.g., multiple 18650 cells)</p>
                <p class="note">This is conservative for 24/7 reliability. Oversize for variable weather.</p>
            `;

            document.getElementById('results').innerHTML = results;
        }

        // Run on load with defaults
        window.onload = calculate;
    </script>
</body>
</html>
